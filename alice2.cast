[0.453, "o", "\u001b[3A\u001b[2C\u001b[27mf\u001b[27mo\u001b[27mr\u001b[27m \u001b[27mp\u001b[27mo\u001b[27md\u001b[27m \u001b[27mi\u001b[27mn\u001b[27m \u001b[27ms\u001b[27ml\u001b[27ma\u001b[27mp\u001b[27md\u001b[27m-\u001b[27m0\u001b[27m \u001b[27ms\u001b[27ml\u001b[27ma\u001b[27mp\u001b[27md\u001b[27m-\u001b[27m1\u001b[27m \u001b[27ms\u001b[27ml\u001b[27ma\u001b[27mp\u001b[27md\u001b[27m-\u001b[27m2\u001b[27m \u001b[27ms\u001b[27ml\u001b[27ma\u001b[27mp\u001b[27md\u001b[27m-\u001b[27mr\u001b[27me\u001b[27ma\u001b[27md\u001b[27mo\u001b[27mn\u001b[27ml\u001b[27my\u001b[27m-\u001b[27m0\u001b[27m;\u001b[27m \u001b[27md\u001b[27mo\u001b[27m \u001b[27me\u001b[27mc\u001b[27mh\u001b[27mo\u001b[27m \u001b[27m$\u001b[27mp\u001b[27mo\u001b[27md\u001b[27m:\u001b[27m;\u001b[27m \u001b[27ms\u001b[27ml\u001b[27mc\u001b[27mt\u001b[27ml\u001b[27m \u001b[27ml\u001b[27mda\u001b[27mp\u001b[27ms\u001b[27me\u001b[27ma\u001b[27mr\u001b[27mc\u001b[27mh\u001b[27m \u001b[27m-\u001b[27m-\u001b[27mv\u001b[27me\u001b[27mr\u001b[27mb\u001b[27mo\u001b[27ms\u001b[27me\u001b[27m \u001b[27m-\u001b[27mn\u001b[27m \u001b[27ms\u001b[27ml\u001b[27ma\u001b[27mp\u001b[27mt\u001b[27ma\u001b[27mi\u001b[27mn\u001b[27m-\u001b[27md\u001b[27me\u001b[27mm\u001b[27mo\u001b[27m \u001b[27m-\u001b[27m-\u001b[27mp\u001b[27mo\u001b[27md\u001b[27m \u001b[27m$\u001b[27mp\u001b[27mo\u001b[27md\u001b[27m \u001b[27m-\u001b[27m-\u001b[27ma\u001b[27mn\u001b[27mo\u001b[27mn\u001b[27my\u001b[27mm\u001b[27mo\u001b[27mu\u001b[27ms\u001b[27m \u001b[27m-\u001b[27m-\u001b[27m \u001b[27m-\u001b[27mb\u001b[27m \u001b[27md\u001b[27mc\u001b[27m=\u001b[27md\u001b[27me\u001b[27mm\u001b[27mo\u001b[27m,\u001b[27md\u001b[27mc\u001b[27m=\u001b[27me\u001b[27mxa\u001b[27mm\u001b[27mp\u001b[27ml\u001b[27me\u001b[27m \u001b[27m-\u001b[27ms\u001b[27m \u001b[27mb\u001b[27ma\u001b[27ms\u001b[27me\u001b[27m \u001b[27mc\u001b[27mo\u001b[27mn\u001b[27mt\u001b[27me\u001b[27mx\u001b[27mt\u001b[27mC\u001b[27mS\u001b[27mN\u001b[27m \u001b[27m-\u001b[2