[0.544, "o", "\u001b[10A\b\b\u001b[27ms\u001b[27ml\u001b[27mc\u001b[27mt\u001b[27ml\u001b[27m \u001b[27ml\u001b[27md\u001b[27ma\u001b[27mp\u001b[27ma\u001b[27md\u001b[27md\u001b[27m \u001b[27m-\u001b[27mn\u001b[27m \u001b[27ms\u001b[27ml\u001b[27ma\u001b[27mp\u001b[27mt\u001b[27ma\u001b[27mi\u001b[27mn\u001b[27m-\u001b[27md\u001b[27me\u001b[27mm\u001b[27mo\u001b[27m \u001b[27m<\u001b[27m<\u001b[27m'\u001b[27mL\u001b[27mD\u001b[27mI\u001b[27mF\u001b[27m'\u001b[1B\r\u001b[27md\u001b[27mn\u001b[27m:\u001b[27m \u001b[27mu\u001b[27mi\u001b[27md\u001b[27m=\u001b[27ma\u001b[27ml\u001b[27mi\u001b[27mc\u001b[27me\u001b[27m,\u001b[27mo\u001b[27mu\u001b[27m=\u001b[27mP\u001b[27me\u001b[27mo\u001b[27mp\u001b[27ml\u001b[27me\u001b[27m,\u001b[27md\u001b[27mc\u001b[27m=\u001b[27md\u001b[27me\u001b[27mm\u001b[27mo\u001b[27m,\u001b[27md\u001b[27mc\u001b[27m=\u001b[27me\u001b[27mx\u001b[27ma\u001b[27mm\u001b[27mp\u001b[27ml\u001b[27me\u001b[1B\r\u001b[27mo\u001b[27mb\u001b[27mj\u001b[27me\u001b[27mc\u001b[27mt\u001b[27mC\u001b[27ml\u001b[27ma\u001b[27ms\u001b[27ms\u001b[27m:\u001b[27m \u001b[27md\u001b[27me\u001b[27mm\u001b[27mo\u001b[27mU\u001b[27ms\u001b[27me\u001b[27mr\u001b[1B\r\u001b[27mc\u001b[27mn\u001b[27m:\u001b[27m \u001b[27mA\u001b[27ml\u001b[27mi\u001b[27mc\u001b[27me\u001b[27m \u001b[27mE\u001b[27mx\u001b[27ma\u001b[27mm\u001b[27mp\u001b[27ml\u001b[27me\u001b[1B\r\u001b[27ms\u001b[27mn\u001b[27m:\u001b[27m \u001b[27mE\u001b[27mx\u001b[27ma\u001b[27mm\u001b[27mp\u001b[27ml\u001b[27me\u001b[1B\r\u001b[27mu\u001b[27mi\u001b[27md\u001b[27m:\u001b[27m \u001b[27ma\u001b[27ml\u001b[27mi\u001b[27mc\u001b[27me\u001b[1B\r\u001b[27mm\u001b[27ma\u001b[27mi\u001b[27ml\u001b[27m:\u001b[27m \u001b[27ma\u001b[27ml\u001b[27mi\u001b[27mc\u001b[27me\u001b[27m@\u001b[27md\u001b[27me\u001b[27mm\u001b[27mo\u001b[27m.\u001b[27me\u001b[27mx\u001b[27ma\u001b[27mm\u001b[27mp\u001b[27ml\u001b[27me\u001b[1B\r\u001b[27mu\u001b[27ms\u001b[27me\u001b[27mr\u001b[27mP\u001b[27ma\u001b[27ms\u001b[27ms\u0