
=== slapd build under test
@(#) $OpenLDAP: slapd 2.7.1-0+slaptain1 (Sep 11 2026 10:00:00) $
	slaptain <noreply@chuck-chuck-chuck.net>


=== configuration (identical on both nodes bar serverID/ports/paths)
include /etc/ldap/schema/core.schema
include /etc/ldap/schema/cosine.schema
include /etc/ldap/schema/inetorgperson.schema

pidfile  /srv/its9580/A/slapd.pid
argsfile /srv/its9580/A/slapd.args

modulepath /usr/lib/ldap
moduleload back_mdb
moduleload syncprov
moduleload accesslog

serverID 1

# ---- change journal (the delta-syncrepl log DB) ------------------------
database  mdb
suffix    "cn=accesslog"
directory /srv/its9580/A/log
maxsize   1073741824
rootdn    "cn=admin,cn=accesslog"
rootpw    secret
index     entryCSN,objectClass,reqEnd,reqResult,reqStart,reqDN eq

overlay   syncprov
syncprov-nopresent  TRUE
syncprov-reloadhint TRUE

# ---- data --------------------------------------------------------------
database  mdb
suffix    "dc=example,dc=org"
directory /srv/its9580/A/data
maxsize   1073741824
rootdn    "cn=admin,dc=example,dc=org"
rootpw    secret
index     objectClass,entryCSN,entryUUID eq

multiprovider TRUE

overlay   syncprov

overlay   accesslog
logdb     "cn=accesslog"
logops    writes
logsuccess TRUE
logpurge  07+00:00 01+00:00

syncrepl rid=002
  provider=ldap://127.0.0.1:9002
  bindmethod=simple
  binddn="cn=admin,dc=example,dc=org"
  credentials=secret
  searchbase="dc=example,dc=org"
  type=refreshAndPersist
  retry="5 +"
  syncdata=accesslog
  logbase="cn=accesslog"
  logfilter="(&(objectClass=auditWriteObject)(reqResult=0))"

