          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "slaptain_database_condition{namespace=\"$namespace\",cluster=~\"$cluster\",site=~\"$site\"}",
          "legendFormat": "{{cluster}}/{{database}}  {{site}}  {{condition}}  ({{reason}})",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cross-site CSN lag",
      "description": "Absent on a healthy link, by design \u2014 the operator only sets lagSeconds while the verdict is Lagging, and this panel shows the absence rather than a zero (ADR-033 decision 5). Also absent on an idle-but-broken link: lag is only observable while writes flow, which is why link state above is the primary signal and this is the magnitude behind it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
