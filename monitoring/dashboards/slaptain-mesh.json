          "editorMode": "code",
          "expr": "slaptain_cluster_condition{namespace=\"$namespace\",mesh=\"$mesh\",cluster=~\"$cluster\",site=~\"$site\",condition=~\"Ready|ReplicationConverged|PodsResponsive|TLSReady|MeshResolved\"}",
          "legendFormat": "{{cluster}}  {{site}}  {{condition}}  ({{reason}})",
          "range": true,
          "refId": "A"
